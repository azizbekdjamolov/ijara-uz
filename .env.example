# ── Django ────────────────────────────────────────────────────────────────
DJANGO_SETTINGS_MODULE=config.settings.dev
DJANGO_SECRET_KEY=dev-secret-key-change-me
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# ── Database (PostgreSQL) ─────────────────────────────────────────────────
POSTGRES_DB=ijara
POSTGRES_USER=ijara
POSTGRES_PASSWORD=ijara_dev_password
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# ── Redis / Celery ────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2

# ── JWT ───────────────────────────────────────────────────────────────────
JWT_ACCESS_LIFETIME_MINUTES=30
JWT_REFRESH_LIFETIME_DAYS=7

# ── CORS (frontend origins, comma separated) ──────────────────────────────
CORS_ALLOWED_ORIGINS=http://localhost:3000

# ── Email (dev: console backend; mailpit: SMTP localhost:1025) ────────────
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=smtp
EMAIL_PORT=1025
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=False
DEFAULT_FROM_EMAIL=Ijara.uz <no-reply@ijara.uz>

# ── S3-compatible storage (MinIO in dev) ──────────────────────────────────
AWS_ACCESS_KEY_ID=ijara
AWS_SECRET_ACCESS_KEY=ijara_dev_password
AWS_STORAGE_BUCKET_NAME=ijara
AWS_S3_ENDPOINT_URL=http://localhost:9000
AWS_S3_REGION_NAME=us-east-1
STORAGE_BACKEND=local            # local | s3

# ── Gemini AI (optional) ───────────────────────────────────────────────────
GEMINI_API_KEY=

# ── Telegram Login Widget (optional) ───────────────────────────────────────
# Bot token from @BotFather. Enables "Telegram orqali kirish".
TELEGRAM_BOT_TOKEN=
# Frontend: the public @username of the bot (without @).
NEXT_PUBLIC_TELEGRAM_BOT_USERNAME=

# ── Frontend ──────────────────────────────────────────────────────────────
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1
